# Live feed configuration
#
# /vibes — last.fm scrobbles
# Get an API key at https://www.last.fm/api/account/create
VITE_LASTFM_USER=your_lastfm_username
VITE_LASTFM_KEY=your_lastfm_api_key
# VITE_LASTFM_API=https://ws.audioscrobbler.com/2.0/
#
# /ai — tokscale, fetched LIVE via the same-origin /toks proxy
# (vite dev proxy + nginx location in nginx.conf forward it to the
# tokscale public API — no CORS headers on tokscale.ai, so direct
# browser fetches are impossible)
VITE_TOKSCALE_USER=RakaiSeto
# Fallback snapshot (used if the proxy fails), refresh with:  bun run sync:ai
VITE_TOKSCALE_JSON=/ai.json
