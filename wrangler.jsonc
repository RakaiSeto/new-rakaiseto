{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rakaiseto-com",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    { "pattern": "rakaiseto.com/*", "zone_name": "rakaiseto.com" },
    { "pattern": "www.rakaiseto.com/*", "zone_name": "rakaiseto.com" }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
